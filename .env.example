# =============================================================================
# BUCKLABS AI — Environment Configuration Template
# Copy this file to .env for local development or configure in Vercel Settings.
# Never commit real secret keys or .env files to Git.
# =============================================================================

# Public Client & SSR Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Server-Side Supabase Configuration (mirrors public URL and anon key for SSR)
SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Explicit Local/Sandbox Persistence Fallback Flag (Development/Test ONLY)
# Must be "false" or unset in Production so failed Supabase writes never produce false success states.
VITE_ENABLE_LOCAL_FALLBACK="false"

# Privileged Server-Only Keys (NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional AI Provider Configuration (Server-Only — NEVER prefix with VITE_)
# OPENAI_API_KEY="sk-..."
# AI_MODEL_ID="gpt-4o-mini"
